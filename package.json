{
  "name": "shortener-api",
  "version": "0.1.0",
  "scripts": {
    "dev:api": "node --env-file=.env --watch --import tsx src/api.ts | pino-pretty",
    "dev:worker": "node --env-file=.env --watch --import tsx src/worker.ts | pino-pretty",
    "setup": "node --env-file=.env --import tsx src/setup.ts | pino-pretty",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "LOG_LEVEL=silent vitest run test/unit",
    "test:integration": "LOG_LEVEL=silent vitest run test/integration --no-file-parallelism",
    "test": "npm run test:unit && npm run test:integration"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@confluentinc/kafka-javascript": "^1.11.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.12.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
